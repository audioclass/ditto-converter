{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ditto Converter",
  "version": "0.1.0",
  "identifier": "org.dittoconverter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/verify-bundle.mjs",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{"label":"main", "title":"Ditto Converter", "width":1080, "height":760, "minWidth":780, "minHeight":600, "visible":false, "center":true, "preventOverflow":{"width":32,"height":32}, "dragDropEnabled":true}],
    "security": {
      "csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "assetProtocol":{"enable":true,"scope":[]}
    }
  },
  "bundle": {
    "active":true,
    "targets":["deb"],
    "shortDescription":"Local backing-track preparation for Ditto+",
    "category":"Music",
    "resources":{"resources/":"resources/"},
    "icon":["icons/icon.png"],
    "windows":{"webviewInstallMode":{"type":"downloadBootstrapper"}},
    "macOS":{"minimumSystemVersion":"13.0"}
  }
}
