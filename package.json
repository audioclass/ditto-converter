{
  "name": "ditto-converter",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "tsc -p ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "preview": "vite preview --config ui/vite.config.ts",
    "tauri": "tauri",
    "prepare:dependencies": "node scripts/prepare-remediation.mjs",
    "prebuild:desktop": "node scripts/prepare-remediation.mjs",
    "build:desktop": "tauri build --features desktop",
    "test": "node --experimental-strip-types --test ui/tests/*.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
